# Files that should NOT be uploaded as static assets to Cloudflare Workers.
# Syntax follows .gitignore rules.

# Build output / dependencies
node_modules
.git
.gitignore
.assetsignore

# Project tooling & config (not part of the served site)
package.json
package-lock.json
wrangler.toml
tailwind.config.js

# Leftover Eleventy / Netlify scaffolding (the live site is served from the repo root)
public

